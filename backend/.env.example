# ============================================================
# Canon Story Studio — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your keys.
# At least one AI provider is needed; Groq is recommended (free).

# ------------------------------------------------------------
# PRIMARY: Groq API (FREE — https://console.groq.com)
# Get a free key in 30 seconds, no credit card required.
# ------------------------------------------------------------
GROQ_API_KEY=

# Groq model to use (default: llama-3.3-70b-versatile)
# Other options: llama-3.1-8b-instant  (fastest, lighter)
#                mixtral-8x7b-32768     (longer context)
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------
# FALLBACK: Gemini API (optional — https://aistudio.google.com)
# Used automatically if Groq fails or is not set.
# ------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-latest

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
PORT=5000
NODE_ENV=development
